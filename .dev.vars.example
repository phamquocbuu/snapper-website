# Local vars for `npx wrangler pages dev .` (copy to .dev.vars, which is git-ignored).
# In production these are set under Pages project -> Settings -> Variables and Secrets.

# Which Paddle account to talk to. Required. No default - the checkout
# function returns HTTP 500 if this is unset or not exactly one of these.
PADDLE_ENVIRONMENT=sandbox

# Public Paddle.js client-side token (test_... in sandbox, live_... in production).
# Safe to expose to the browser. Paddle > Developer tools > Authentication.
PADDLE_CLIENT_TOKEN=test_9b2434436dc43ba00d28fba019b

# Catalog price IDs (sandbox). Re-seed with claude-docs/seed-paddle-catalog.mjs
# in the app repo for production IDs.
PADDLE_PRICE_PRO_FIRST=pri_01m18c0ef5q3qb397k38bwzrqk
PADDLE_PRICE_PRO_RENEWAL=pri_01m18c0esr3w0ezxsv1jmhbgvw
PADDLE_PRICE_LIFETIME=pri_01m18c0fg625fpqr61sgt071k0

# Secret server-side API key. Only consumed once customer pre-fill is wired
# to real web auth; the current stub never signs anyone in. Never exposed
# to the client. pdl_sdbx_... in sandbox, pdl_live_... in production.
# PADDLE_API_KEY=

# --- License backend (functions/api/paddle-webhook.js, activate.js,
#     deactivate.js; D1 binding LICENSE_DB from wrangler.toml) ---

# This notification destination's secret. Paddle > Developer tools >
# Notifications > your destination. NOT the same as PADDLE_API_KEY.
PADDLE_WEBHOOK_SECRET=pdl_ntfset_...

# base64 PKCS#8 Ed25519 private key that signs activation receipts.
# Generate with: node scripts/gen-license-keypair.mjs
# Production: npx wrangler pages secret put LICENSE_SIGNING_KEY
LICENSE_SIGNING_KEY=

# Resend, for emailing the license key to the buyer (free tier is plenty
# for now). Verify the sending domain in Resend first. RESEND_FROM must be
# an address on that domain. If either is unset the webhook still stores
# the key and /thanks still shows it - only the email is skipped.
RESEND_API_KEY=re_...
RESEND_FROM=Snapper <snapper@nexis.io.vn>

# PADDLE_API_KEY (above) is now REQUIRED, not optional: the webhook uses it
# to look up the buyer's email, and /api/license-lookup uses it to verify
# the transaction before revealing the key on /thanks.
